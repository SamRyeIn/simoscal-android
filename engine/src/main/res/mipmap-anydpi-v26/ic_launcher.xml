<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by store/make_store_graphics.py, mipmaps mode. The foreground is
  the same artwork as the 512x512 Play icon, inset to the adaptive icon's
  guaranteed-visible square; the background is the app's own ground, so a
  round or squircle mask crops padding rather than the mark.

  No monochrome layer, deliberately. A themed-icon launcher tints that
  layer flat and drops it on a wallpaper-derived ground, which turns this
  artwork into an unreadable disc; a real monochrome layer needs a
  purpose-drawn silhouette, and the wordmark does not reduce to one.
  Without the element, those launchers fall back to the adaptive icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/promo_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
